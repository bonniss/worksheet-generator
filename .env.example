# Sao chép file này thành .env.local (khi chạy máy) và điền giá trị thật.
# Trên Vercel: thêm các biến này trong Project Settings > Environment Variables.
# Không bắt buộc: API key + model có thể đặt trong app (Quản trị → Cấu hình AI, lưu vào DB).
# Giá trị trong app được ưu tiên; hai biến dưới chỉ là dự phòng khi app chưa cấu hình.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Khoá mã hoá API key lưu trong DB. Nên đặt một chuỗi ngẫu nhiên dài (vd: openssl rand -base64 32).
# Nếu để trống sẽ suy ra từ DATABASE_URL. Đổi giá trị này thì phải nhập lại API key trong app.
SETTINGS_SECRET=""

# Neon Postgres connection string (Neon console > Connection Details)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin đầu tiên, dùng cho `npm run db:seed` (ADMIN_EMAIL không bắt buộc)
ADMIN_USERNAME="admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Administrator"

# Sao chép thành .env.local khi chạy trên máy rồi điền giá trị thật.
# Cột [Vercel] cho biết biến có cần thêm ở Project Settings > Environment Variables hay không.

# ─── Bắt buộc ────────────────────────────────────────────────────────────────

# [Vercel: có] Neon Postgres connection string (Neon console > Connection Details,
# hoặc `neon link` tự ghi vào .env.local)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# [Vercel: có] Khoá mã hoá Anthropic API key lưu trong DB. Tạo bằng: openssl rand -base64 32
# Để trống thì suy ra từ DATABASE_URL (kém an toàn hơn). Đổi giá trị này thì phải nhập lại API key trong app.
SETTINGS_SECRET=""

# ─── Tuỳ chọn: AI ────────────────────────────────────────────────────────────
# Nên cấu hình trong app (Quản trị > Cấu hình AI) — đổi lúc chạy, không cần deploy lại.
# Hai biến dưới chỉ là dự phòng khi app chưa cấu hình; giá trị trong app luôn được ưu tiên.

# [Vercel: tuỳ chọn]
ANTHROPIC_API_KEY=""
# [Vercel: tuỳ chọn] Mặc định claude-haiku-4-5
ANTHROPIC_MODEL=""

# ─── Chỉ dùng trên máy: tạo admin đầu tiên (`npm run db:seed`) ──────────────
# [Vercel: không] Seed chạy từ máy, trỏ DATABASE_URL tới DB cần tạo admin.
# Username: 3–32 ký tự a-z, 0-9, . _ -  ·  Mật khẩu: tối thiểu 8 ký tự  ·  Email: không bắt buộc
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Administrator"
ADMIN_EMAIL=""

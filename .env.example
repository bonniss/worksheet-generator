# Sao chép file này thành .env.local (khi chạy máy) và điền giá trị thật.
# Trên Vercel: thêm các biến này trong Project Settings > Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL="claude-haiku-4-5"

# Neon Postgres connection string (Neon console > Connection Details)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin đầu tiên, dùng cho `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Administrator"
